{
    "name": "alfrahi/woosecureproxy",
    "description": "Secure WooCommerce REST proxy with HMAC + JWT",
    "require": {
        "php": "^8.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/wp-test-utils": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "WooSecureProxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooSecureProxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "phpstan": "php -d memory_limit=2G tools/phpstan.phar analyse",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
