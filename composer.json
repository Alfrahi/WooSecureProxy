{
    "name": "alfrahi/woosecureproxy",
    "description": "Secure WooCommerce REST proxy with HMAC + JWT",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^9.6",
        "yoast/wp-test-utils": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "WooSecureProxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooSecureProxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
